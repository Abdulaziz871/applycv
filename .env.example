# كلمة السر المشتركة لدخول التطبيق
APP_PASSWORD=change-me

# سر لتوقيع الجلسة (32 حرفاً على الأقل). ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# مفتاح Gemini المجاني من https://aistudio.google.com/apikey
GEMINI_API_KEY=
# اسم النموذج (اختياري) - يجب أن يكون ضمن الطبقة المجانية
GEMINI_MODEL=gemini-3.6-flash
# نماذج احتياطية (اختياري) تُجرَّب تلقائياً عند ازدحام النموذج الأساسي، مفصولة بفواصل
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# للتطوير المحلي فقط: مسار Chrome/Edge المثبت على جهازك (لتصدير PDF)
# مثال ويندوز: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=

# للتجربة بدون مفتاح (يعمل فقط خارج الإنتاج): AI_PROVIDER=mock
AI_PROVIDER=
# للتجربة بدون Google (يعمل خارج الإنتاج فقط): GMAIL_MODE=mock
GMAIL_MODE=

# ---- إرسال Gmail (راجع README الخطوة 9) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
